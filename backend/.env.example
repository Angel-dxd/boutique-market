# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Renombra este archivo a ".env" y ajusta los valores para tu entorno.
# Este archivo SI puede subirse a Git (no contiene contraseñas reales).
# ============================================================

# --- Configuración de Base de Datos Principal ---
# Host de la base de datos
DB_HOST=localhost
# Usuario de la base de datos
DB_USER=root
# Contraseña de la base de datos
DB_PASS=tu_password_aqui
# Nombre de la base de datos
DB_NAME=boutique_market

# --- Configuración del Servidor ---
# Puerto donde se levantará el backend (Ej: 3000, 8080)
PORT=3000
# Origen permitido para CORS (Frontend)
CORS_ORIGIN=http://localhost:4200

# --- Seguridad y Encriptación ---
# Llave de 32 caracteres exactos para encriptar datos en la BD
ENCRYPTION_KEY=PON_AQUI_32_CARACTERES_EXACTOS_X
# Llave utilizada para el cifrado AES
CRYPTO_KEY=12345678901234567890123456789012
# Token de largo plazo de la API de Graph de Instagram (Opcional)
INSTAGRAM_TOKEN=tu_token_largo_de_instagram_aqui
# Clave secreta para la firma de tokens JWT
JWT_SECRET=una_clave_super_secreta_para_jwt
# Tiempo de expiración del token JWT
JWT_EXPIRES_IN=12h
# Determina si se permite el registro de nuevos usuarios desde el frontend
ALLOW_PUBLIC_REGISTER=true