# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Renombra este archivo a ".env" y ajusta los valores para tu entorno.
# Este archivo SÍ puede subirse a Git (no contiene contraseñas reales).
# ============================================================

# --- Entorno ---
# 'development' (CORS abierto, errores detallados) | 'production' (CORS estricto)
NODE_ENV=development

# --- Servidor ---
# Puerto donde se levantará el backend (Render lo sobreescribe en producción)
PORT=3000

# --- Base de Datos Postgres (Supabase) ---
# Cadenas de conexión, una por tenant. Cada tenant puede ser un proyecto Supabase
# distinto o el mismo con schemas separados.
# Sácalas en: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Modo 'Transaction pooler' (puerto 6543) para serverless / 'Session' (5432) para Render.
DATABASE_URL_MARKET=postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL_SANTI=postgresql://postgres.<ref-santi>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# --- Seguridad y Encriptación ---
# Llave de 32 caracteres exactos para encriptar datos en la BD
ENCRYPTION_KEY=PON_AQUI_32_CARACTERES_EXACTOS_X
# Llave utilizada para el cifrado AES (32 bytes hex = 64 caracteres)
# Genera con: openssl rand -hex 32
CRYPTO_KEY=12345678901234567890123456789012
# Token de largo plazo de la API de Graph de Instagram (Opcional)
INSTAGRAM_TOKEN=tu_token_largo_de_instagram_aqui
# Clave secreta para la firma de tokens JWT (mínimo 64 caracteres aleatorios)
# Genera con: openssl rand -hex 64
JWT_SECRET=una_clave_super_secreta_para_jwt
# Tiempo de expiración del token JWT
JWT_EXPIRES_IN=12h

# --- CORS y Política de Registro ---
# Lista de orígenes permitidos en producción separados por coma
ALLOWED_ORIGINS=https://boutique-market.vercel.app,http://localhost:4200
# Determina si se permite el registro de nuevos usuarios desde el frontend
ALLOW_PUBLIC_REGISTER=false
